# ==============================================================================
# Legal Metrology Online Verification System - Environment Configuration
# ==============================================================================

# Django Secret Key (Replace with a cryptographically secure random string in production)
SECRET_KEY=django-insecure-sih-2026-legal-metrology-verification-platform-key-change-in-production

# Debug Mode: Set to False in production environments
DEBUG=True

# Allowed Hosts: Comma-separated domain names or IP addresses
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.run.app

# Database Configuration:
# Default SQLite local database (zero-configuration):
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL example:
# DATABASE_URL=postgres://metrology_user:metrology_password@localhost:5432/legal_metrology_db

# CSRF Trusted Origins for reverse proxies and cloud hosting:
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://*.run.app

# Optional Email Backend Settings (for Password Reset):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
